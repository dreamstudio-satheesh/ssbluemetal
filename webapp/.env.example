# Copy to .env and set a long random secret:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
WEBAPP_SECRET=change-me
TOKEN_TTL_HOURS=12
# Comma-separated origins, only for a browser/WebView client. Empty for a native APK.
ALLOWED_ORIGINS=
# 0 disables /docs and /openapi.json (recommended for public tunnels)
API_DOCS=1
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_SECONDS=600
# Only for a named Cloudflare tunnel (docker compose --profile tunnel up)
TUNNEL_TOKEN=
